{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmpark-creator.github.io/project-dashboard/ai-video-studio/codex/schemas/domain.schema.json",
  "title": "AI Video Studio Domain Schema",
  "type": "object",
  "$defs": {
    "Intent": {
      "type": "string",
      "enum": ["shorts", "product_ad", "app_intro", "real_estate", "education", "brand"]
    },
    "Tier": {
      "type": "string",
      "enum": ["fast", "economy", "final"]
    },
    "Aspect": {
      "type": "string",
      "enum": ["9:16", "16:9", "1:1", "4:5"]
    },
    "ProjectStatus": {
      "type": "string",
      "enum": ["draft", "storyboarded", "generating", "reviewing", "edited", "rendering", "done", "failed"]
    },
    "ShotStatus": {
      "type": "string",
      "enum": ["pending", "generating", "reviewing", "selected", "failed"]
    },
    "JobStatus": {
      "type": "string",
      "enum": ["queued", "running", "done", "failed", "cancelled"]
    },
    "RenderSourceHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "AssetUsageMode": {
      "type": "string",
      "enum": ["first_frame", "last_frame", "style_reference", "character_reference", "product_reference", "background_reference"]
    },
    "ImageAssetRole": {
      "type": "string",
      "enum": ["product", "character", "location", "style", "keyframe", "thumbnail", "logo", "background"]
    },
    "ImageMakerPurpose": {
      "type": "string",
      "enum": ["photoreal", "product", "character", "background", "style", "poster", "thumbnail", "transparent"]
    },
    "SAEC": {
      "type": "object",
      "required": ["subject", "action", "environment", "camera", "framing", "lighting", "style", "negative"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string" },
        "action": { "type": "string" },
        "environment": { "type": "string" },
        "camera": { "type": "string" },
        "framing": { "type": "string" },
        "lighting": { "type": "string" },
        "style": { "type": "string" },
        "negative": { "type": "string" }
      }
    },
    "ShotRequirements": {
      "type": "object",
      "required": ["tier", "aspect", "imageToVideo", "needsLipsyncAudio", "motionHeavy", "characterLock"],
      "additionalProperties": false,
      "properties": {
        "tier": { "$ref": "#/$defs/Tier" },
        "aspect": { "$ref": "#/$defs/Aspect" },
        "resolution": { "type": "string", "enum": ["540p", "720p", "1080p", "4k"] },
        "imageToVideo": { "type": "boolean" },
        "needsLipsyncAudio": { "type": "boolean" },
        "motionHeavy": { "type": "boolean" },
        "characterLock": { "type": "boolean" },
        "characterId": { "type": ["string", "null"] },
        "region": { "type": "string" }
      }
    },
    "QualityFlag": {
      "type": "object",
      "required": ["axis", "score", "hint"],
      "additionalProperties": false,
      "properties": {
        "axis": {
          "type": "string",
          "enum": ["fidelity", "consistency", "motion", "transition", "audio", "completeness"]
        },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "hint": { "type": "string" }
      }
    },
    "Project": {
      "type": "object",
      "required": ["id", "title", "intent", "status", "aspect", "targetDurationSec", "progress", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^prj_" },
        "title": { "type": "string" },
        "intent": { "$ref": "#/$defs/Intent" },
        "status": { "$ref": "#/$defs/ProjectStatus" },
        "aspect": { "$ref": "#/$defs/Aspect" },
        "targetDurationSec": { "type": "integer", "minimum": 1 },
        "progress": {
          "type": "object",
          "required": ["shotsDone", "shotsTotal"],
          "additionalProperties": false,
          "properties": {
            "shotsDone": { "type": "integer", "minimum": 0 },
            "shotsTotal": { "type": "integer", "minimum": 0 }
          }
        },
        "characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/Character" },
          "default": []
        },
        "thumbUrl": { "type": ["string", "null"], "format": "uri" },
        "credits": { "$ref": "#/$defs/CreditSummary" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Character": {
      "type": "object",
      "required": ["id", "label", "refImageUrls"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^chr_" },
        "label": { "type": "string" },
        "refImageUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "CreditSummary": {
      "type": "object",
      "required": ["spent", "estimateRemaining"],
      "additionalProperties": false,
      "properties": {
        "spent": { "type": "number", "minimum": 0 },
        "estimateRemaining": { "type": "number", "minimum": 0 }
      }
    },
    "StudioCredits": {
      "type": "object",
      "required": ["balance", "spent", "reserved"],
      "additionalProperties": false,
      "properties": {
        "balance": { "type": "number", "minimum": 0 },
        "spent": { "type": "number", "minimum": 0 },
        "reserved": { "type": "number", "minimum": 0 }
      }
    },
    "Scene": {
      "type": "object",
      "required": ["id", "projectId", "order", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^scn_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "setting": { "type": "string" },
        "timeOfDay": { "type": "string" }
      }
    },
    "Shot": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "sceneId",
        "order",
        "title",
        "durationSec",
        "saec",
        "requirements",
        "status",
        "selectedTakeId",
        "qualityFlags",
        "referenceImageIds",
        "directionSpec"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sht_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "sceneId": { "type": "string", "pattern": "^scn_" },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 1, "maximum": 16 },
        "saec": { "$ref": "#/$defs/SAEC" },
        "requirements": { "$ref": "#/$defs/ShotRequirements" },
        "status": { "$ref": "#/$defs/ShotStatus" },
        "selectedTakeId": { "type": ["string", "null"], "pattern": "^tak_" },
        "qualityFlags": {
          "type": "array",
          "items": { "$ref": "#/$defs/QualityFlag" }
        },
        "referenceImageIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^img_" }
        },
        "directionSpec": { "$ref": "#/$defs/DirectionSpec" }
      }
    },
    "DirectionSpec": {
      "type": "object",
      "required": ["camera", "composition", "lighting", "motion", "style", "avoid", "notes"],
      "additionalProperties": false,
      "properties": {
        "camera": { "type": "string" },
        "composition": { "type": "string" },
        "lighting": { "type": "string" },
        "motion": { "type": "string" },
        "style": { "type": "string" },
        "avoid": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "Take": {
      "type": "object",
      "required": ["id", "shotId", "label", "status", "durationSec", "tier", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^tak_" },
        "shotId": { "type": "string", "pattern": "^sht_" },
        "label": { "type": "string" },
        "status": { "$ref": "#/$defs/JobStatus" },
        "videoUrl": { "type": ["string", "null"], "format": "uri" },
        "posterUrl": { "type": ["string", "null"], "format": "uri" },
        "durationSec": { "type": "number", "minimum": 1 },
        "tier": { "$ref": "#/$defs/Tier" },
        "engineUsed": { "type": ["string", "null"], "description": "Internal/debug only; never render in user UI." },
        "metrics": { "$ref": "#/$defs/TakeMetrics" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TakeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fidelity": { "type": "number", "minimum": 1, "maximum": 5 },
        "consistency": { "type": "number", "minimum": 1, "maximum": 5 },
        "motion": { "type": "number", "minimum": 1, "maximum": 5 },
        "transition": { "type": "number", "minimum": 1, "maximum": 5 },
        "audio": { "type": "number", "minimum": 1, "maximum": 5 },
        "completeness": { "type": "number", "minimum": 1, "maximum": 5 },
        "overall": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "GenerationJob": {
      "type": "object",
      "required": ["id", "shotId", "takeId", "projectId", "status", "progress", "stage", "shouldFail", "dueAt", "createdAt", "updatedAt", "error", "promptPackage", "routing"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^gen_" },
        "shotId": { "type": "string", "pattern": "^sht_" },
        "takeId": { "type": "string", "pattern": "^tak_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "status": { "$ref": "#/$defs/JobStatus" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "etaSec": { "type": ["integer", "null"], "minimum": 0 },
        "stage": { "type": "string" },
        "shouldFail": { "type": "boolean" },
        "dueAt": { "type": "integer" },
        "error": { "$ref": "#/$defs/ErrorResponse" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "promptPackage": { "$ref": "#/$defs/GenerationPromptPackage" },
        "routing": { "$ref": "#/$defs/ProviderRoutingDecision" }
      }
    },
    "ProviderRouteTarget": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "ProviderRoutingDecision": {
      "type": "object",
      "required": ["ruleId", "selected", "candidates", "rejected", "splitTakeIndex", "fallbackEnabled", "hiddenFromUser"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string" },
        "selected": { "$ref": "#/$defs/ProviderRouteTarget" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderRouteTarget" }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "model", "reason"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string" },
              "model": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "splitTakeIndex": { "type": "integer", "minimum": 0 },
        "fallbackEnabled": { "type": "boolean" },
        "hiddenFromUser": { "type": "boolean" }
      }
    },
    "GenerationReference": {
      "type": "object",
      "required": ["assetId", "role", "mode", "url", "rightsStatus"],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string", "pattern": "^img_" },
        "role": { "$ref": "#/$defs/ImageAssetRole" },
        "mode": { "$ref": "#/$defs/AssetUsageMode" },
        "url": { "type": "string" },
        "rightsStatus": { "type": "string", "enum": ["user_confirmed", "generated", "needs_review"] }
      }
    },
    "GenerationPromptPackage": {
      "type": "object",
      "required": ["projectId", "shotId", "saec", "directionSpec", "requirements", "references", "routingHints"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "pattern": "^prj_" },
        "shotId": { "type": "string", "pattern": "^sht_" },
        "saec": { "$ref": "#/$defs/SAEC" },
        "directionSpec": { "$ref": "#/$defs/DirectionSpec" },
        "requirements": { "$ref": "#/$defs/ShotRequirements" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/GenerationReference" }
        },
        "routingHints": {
          "type": "object",
          "required": [
            "startFrameAssetId",
            "lastFrameAssetId",
            "styleReferenceAssetIds",
            "characterReferenceAssetIds",
            "productReferenceAssetIds",
            "backgroundReferenceAssetIds",
            "rightsReviewRequired"
          ],
          "additionalProperties": false,
          "properties": {
            "startFrameAssetId": { "type": ["string", "null"], "pattern": "^img_" },
            "lastFrameAssetId": { "type": ["string", "null"], "pattern": "^img_" },
            "styleReferenceAssetIds": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
            "characterReferenceAssetIds": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
            "productReferenceAssetIds": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
            "backgroundReferenceAssetIds": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
            "rightsReviewRequired": { "type": "boolean" }
          }
        }
      }
    },
    "ImageAsset": {
      "type": "object",
      "required": ["id", "projectId", "kind", "role", "source", "label", "prompt", "url", "thumbUrl", "aspect", "width", "height", "rights", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^img_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "kind": { "type": "string", "const": "image" },
        "role": { "$ref": "#/$defs/ImageAssetRole" },
        "source": { "type": "string", "enum": ["image_maker", "upload", "external"] },
        "label": { "type": "string" },
        "prompt": { "type": "string" },
        "url": { "type": "string" },
        "thumbUrl": { "type": "string" },
        "aspect": { "$ref": "#/$defs/Aspect" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "rights": {
          "type": "object",
          "required": ["status", "note"],
          "additionalProperties": false,
          "properties": {
            "status": { "type": "string", "enum": ["user_confirmed", "generated", "needs_review"] },
            "note": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ImageVariant": {
      "type": "object",
      "required": ["id", "assetId", "label", "status", "url", "thumbUrl", "scoreLabel"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ivar_" },
        "assetId": { "type": ["string", "null"], "pattern": "^img_" },
        "label": { "type": "string" },
        "status": { "$ref": "#/$defs/JobStatus" },
        "url": { "type": ["string", "null"] },
        "thumbUrl": { "type": ["string", "null"] },
        "scoreLabel": { "type": "string", "enum": ["추천", "안정적", "확인 필요"] }
      }
    },
    "ImageJob": {
      "type": "object",
      "required": ["id", "projectId", "status", "progress", "etaSec", "stage", "prompt", "purpose", "role", "aspect", "style", "count", "variants", "dueAt", "createdAt", "updatedAt", "error"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ijob_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "status": { "$ref": "#/$defs/JobStatus" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "etaSec": { "type": ["integer", "null"], "minimum": 0 },
        "stage": { "type": "string", "enum": ["queued", "prompting", "generating", "saving", "done", "failed"] },
        "prompt": { "type": "string" },
        "purpose": { "$ref": "#/$defs/ImageMakerPurpose" },
        "role": { "$ref": "#/$defs/ImageAssetRole" },
        "aspect": { "$ref": "#/$defs/Aspect" },
        "style": { "type": "string" },
        "count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/ImageVariant" } },
        "dueAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "error": { "$ref": "#/$defs/ErrorResponse" }
      }
    },
    "AssetUsage": {
      "type": "object",
      "required": ["assetId", "role", "target", "targetId", "mode", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string", "pattern": "^img_" },
        "role": { "$ref": "#/$defs/ImageAssetRole" },
        "target": { "type": "string", "enum": ["project", "shot"] },
        "targetId": { "type": "string" },
        "mode": { "$ref": "#/$defs/AssetUsageMode" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ReferenceBoard": {
      "type": "object",
      "required": ["projectId", "productImages", "characterImages", "locationImages", "styleImages", "keyframes", "thumbnails", "logos", "backgrounds", "usages"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "pattern": "^prj_" },
        "productImages": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "characterImages": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "locationImages": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "styleImages": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "keyframes": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "thumbnails": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "logos": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "backgrounds": { "type": "array", "items": { "type": "string", "pattern": "^img_" } },
        "usages": { "type": "array", "items": { "$ref": "#/$defs/AssetUsage" } }
      }
    },
    "ProjectBundle": {
      "type": "object",
      "required": [
        "project",
        "scenes",
        "shots",
        "takes",
        "generationJobs",
        "renderJobs",
        "imageAssets",
        "imageJobs",
        "referenceBoard",
        "editState",
        "credits",
        "renderSourceHash"
      ],
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/$defs/Project" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/Scene" } },
        "shots": { "type": "array", "items": { "$ref": "#/$defs/Shot" } },
        "takes": { "type": "array", "items": { "$ref": "#/$defs/Take" } },
        "generationJobs": { "type": "array", "items": { "$ref": "#/$defs/GenerationJob" } },
        "renderJobs": { "type": "array", "items": { "$ref": "#/$defs/RenderJob" } },
        "imageAssets": { "type": "array", "items": { "$ref": "#/$defs/ImageAsset" } },
        "imageJobs": { "type": "array", "items": { "$ref": "#/$defs/ImageJob" } },
        "referenceBoard": { "$ref": "#/$defs/ReferenceBoard" },
        "editState": { "$ref": "#/$defs/EditState" },
        "credits": { "$ref": "#/$defs/StudioCredits" },
        "renderSourceHash": { "$ref": "#/$defs/RenderSourceHash" }
      }
    },
    "RenderJob": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "spec",
        "stage",
        "progress",
        "status",
        "outputUrl",
        "shareUrl",
        "etaSec",
        "dueAt",
        "createdAt",
        "updatedAt",
        "error",
        "rightsReview",
        "renderPlan"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^rnd_" },
        "projectId": { "type": "string", "pattern": "^prj_" },
        "spec": { "$ref": "#/$defs/ExportSpec" },
        "stage": {
          "type": "string",
          "enum": ["assemble", "audio_mix", "caption_burn", "encode", "upscale", "done"]
        },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/JobStatus" },
        "outputUrl": { "type": ["string", "null"], "format": "uri" },
        "shareUrl": { "type": ["string", "null"], "format": "uri" },
        "etaSec": { "type": ["integer", "null"], "minimum": 0 },
        "dueAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "error": { "$ref": "#/$defs/ErrorResponse" },
        "rightsReview": { "$ref": "#/$defs/RenderRightsReview" },
        "renderPlan": { "$ref": "#/$defs/RenderPlan" }
      }
    },
    "RenderPreview": {
      "type": "object",
      "required": ["projectId", "spec", "sourceHash", "rightsReview", "renderPlan", "estimate"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "pattern": "^prj_" },
        "spec": { "$ref": "#/$defs/ExportSpec" },
        "sourceHash": { "$ref": "#/$defs/RenderSourceHash" },
        "rightsReview": { "$ref": "#/$defs/RenderRightsReview" },
        "renderPlan": { "$ref": "#/$defs/RenderPlan" },
        "estimate": { "$ref": "#/$defs/CostEstimate" }
      }
    },
    "RenderPlan": {
      "type": "object",
      "required": ["projectId", "spec", "sourceHash", "totalDurationSec", "missingShotIds", "shots", "edit"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "pattern": "^prj_" },
        "spec": { "$ref": "#/$defs/ExportSpec" },
        "sourceHash": { "$ref": "#/$defs/RenderSourceHash" },
        "totalDurationSec": { "type": "number", "minimum": 0 },
        "missingShotIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^sht_" }
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shotId", "takeId", "order", "title", "durationSec", "videoUrl", "posterUrl", "tier"],
            "additionalProperties": false,
            "properties": {
              "shotId": { "type": "string", "pattern": "^sht_" },
              "takeId": { "type": "string", "pattern": "^tak_" },
              "order": { "type": "integer", "minimum": 0 },
              "title": { "type": "string" },
              "durationSec": { "type": "number", "minimum": 1 },
              "videoUrl": { "type": ["string", "null"] },
              "posterUrl": { "type": ["string", "null"] },
              "tier": { "$ref": "#/$defs/Tier" }
            }
          }
        },
        "edit": { "$ref": "#/$defs/EditState" }
      }
    },
    "EditState": {
      "type": "object",
      "required": ["projectId", "captions", "bgm", "voiceover", "transitions", "commands"],
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "pattern": "^prj_" },
        "captions": {
          "type": "object",
          "required": ["enabled", "mode", "source"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["burn-in", "srt", "both"] },
            "source": { "type": "string", "enum": ["script-first", "stt"] }
          }
        },
        "bgm": {
          "type": "object",
          "required": ["enabled", "track", "ducking"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "track": { "type": "string" },
            "ducking": { "type": "boolean" }
          }
        },
        "voiceover": {
          "type": "object",
          "required": ["enabled", "voice", "source"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "voice": { "type": "string" },
            "source": { "type": "string", "enum": ["licensed_tts", "user_upload"] }
          }
        },
        "transitions": { "type": "string", "enum": ["none", "soft"] },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "EditCommandInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" }
      }
    },
    "EditAudioPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "captions": { "$ref": "#/$defs/EditState/properties/captions" },
        "bgm": { "$ref": "#/$defs/EditState/properties/bgm" },
        "voiceover": { "$ref": "#/$defs/EditState/properties/voiceover" },
        "transitions": { "$ref": "#/$defs/EditState/properties/transitions" }
      }
    },
    "RenderRightsReview": {
      "type": "object",
      "required": ["required", "assetIds", "items"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "assetIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^img_" }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assetId", "label", "role", "rightsStatus", "note", "targetShotIds"],
            "additionalProperties": false,
            "properties": {
              "assetId": { "type": "string", "pattern": "^img_" },
              "label": { "type": "string" },
              "role": { "$ref": "#/$defs/ImageAssetRole" },
              "rightsStatus": { "type": "string", "enum": ["user_confirmed", "generated", "needs_review"] },
              "note": { "type": "string" },
              "targetShotIds": {
                "type": "array",
                "items": { "type": "string", "pattern": "^sht_" }
              }
            }
          }
        }
      }
    },
    "AssetDeleteResult": {
      "type": "object",
      "required": ["deleted", "assetId", "blockedByUsage", "usageCount", "remainingAssets"],
      "additionalProperties": false,
      "properties": {
        "deleted": { "type": "boolean" },
        "assetId": { "type": "string", "pattern": "^img_" },
        "blockedByUsage": { "type": "boolean" },
        "usageCount": { "type": "integer", "minimum": 0 },
        "remainingAssets": { "type": "integer", "minimum": 0 }
      }
    },
    "ExportSpec": {
      "type": "object",
      "required": ["resolution", "cut", "aspect", "caption"],
      "additionalProperties": false,
      "properties": {
        "resolution": { "type": "string", "enum": ["720p", "1080p", "4k"] },
        "cut": { "type": "string", "enum": ["6s", "15s", "30s", "full"] },
        "aspect": { "$ref": "#/$defs/Aspect" },
        "caption": { "type": "string", "enum": ["none", "burn-in", "srt", "both"] }
      }
    },
    "CostEstimate": {
      "type": "object",
      "required": ["credits", "etaSec"],
      "additionalProperties": false,
      "properties": {
        "credits": { "type": "number", "minimum": 0 },
        "etaSec": { "type": "integer", "minimum": 0 }
      }
    },
    "ErrorResponse": {
      "type": ["object", "null"],
      "required": ["code", "userMessage", "retryable", "fallbackSuggested"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "userMessage": { "type": "string" },
        "retryable": { "type": "boolean" },
        "fallbackSuggested": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "project": { "$ref": "#/$defs/Project" },
    "projectBundle": { "$ref": "#/$defs/ProjectBundle" },
    "scene": { "$ref": "#/$defs/Scene" },
    "shot": { "$ref": "#/$defs/Shot" },
    "take": { "$ref": "#/$defs/Take" },
    "generationJob": { "$ref": "#/$defs/GenerationJob" },
    "renderJob": { "$ref": "#/$defs/RenderJob" }
  }
}
